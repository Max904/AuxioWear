<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): we need to see and bind to Auxio's media service. -->
    <queries>
        <package android:name="org.oxycblt.auxio" />
        <package android:name="org.oxycblt.auxio.debug" />
    </queries>

    <application
        android:name=".CompanionApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".StatusActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Woken by Play Services whenever the watch sends us something. -->
        <service
            android:name=".CompanionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/auxio/w2p" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />
    </application>
</manifest>
